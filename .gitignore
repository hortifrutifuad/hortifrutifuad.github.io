# =========================================
# .gitignore — Hortifruti Fuad
# Protege credenciais, segredos e arquivos
# desnecessários de entrar no repositório.
# =========================================

# --- Variáveis de Ambiente e Segredos ---
# NUNCA commitar arquivos com tokens, senhas ou chaves de API
.env
.env.local
.env.*.local
*.secret
secrets.json
credentials.json

# --- n8n (Fase 2) ---
# Exportações de workflows com credenciais embutidas
n8n-workflows-backup.json
*.n8n.json

# --- Dependências (Node.js / npm) ---
node_modules/
package-lock.json

# --- Arquivos de Build ---
.next/
dist/
build/
out/
.cache/

# --- IDEs e Editores ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Sistema Operacional ---
# Windows
Thumbs.db
Desktop.ini
# macOS
.DS_Store
.AppleDouble
.LSOverride

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Temporários e Backups ---
*.tmp
*.bak
*.swp
*~
